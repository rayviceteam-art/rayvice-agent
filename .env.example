# Rayvice Agent — copy to .env and fill. Never commit .env
# AI layer (OpenRouter free mode, budget 0)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODE=free
ALLOW_PAID_AI=false
# Free models in priority order (first = primary, rest = fallback)
FREE_MODELS=openrouter/free
# Daily safety cap for free calls (pause non-critical after this)
FREE_DAILY_LIMIT=180
# Telegram (approval queue, polling — no domain needed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sirf is Telegram user ke commands chalenge (recommended: set karo production me)
TELEGRAM_ALLOWED_USER_ID=
# Optional: stronger hunting (free 1000/mo, no card) from tavily.com
TAVILY_API_KEY=
# Owner language (hinglish = teri language me baat karega)
AGENT_LANG=hinglish
# Scheduler wall-clock (owner IST) + business TZ (Sydney). Change freely.
TIMEZONE=Asia/Kolkata
BUSINESS_TZ=Australia/Sydney
# Safety: false = sab external action stop. Mode: OBSERVE/ASSIST/SUPERVISED_AUTO/FULL_AUTO
AUTOMATION_ENABLED=true
AGENT_MODE=SUPERVISED_AUTO
# GitHub optional (read-only jab tak token+approval na ho). Khali chhod sakte ho.
GITHUB_TOKEN=
GITHUB_REPO=
# Agent runtime
AGENT_DB_PATH=data/agent.db
LOG_LEVEL=INFO
# Public targets for monitoring (no secrets here)
RAYVICE_SITE=https://www.rayvice.com
RAYVICE_BACKEND=https://rayvice-backend.onrender.com

# ---------------- SOCIAL AUTOMATION ----------------
# DRY-RUN: true = koi real post kabhi nahi. Production ke liye deliberately false karo.
SOCIAL_DRYRUN=true
# Social state apni alag SQLite (public repo me ye hi jata hai)
SOCIAL_DB_PATH=data/social.db
# Business timezone + Sydney-local publish hours
SOCIAL_TZ=Australia/Sydney
SOCIAL_PUBLISH_HOURS=09:00,12:30,17:30
# Platforms jinpe intent enabled (x always blocked — no free API tier)
SOCIAL_PLATFORMS=instagram,facebook,linkedin
# Reddit: sirf in approved subreddits me (khali = Reddit off)
SOCIAL_REDDIT_SUBS=
# Retry policy
SOCIAL_MAX_ATTEMPTS=5
SOCIAL_RETRY_BASE_SECONDS=60

# Image pipeline: pollinations (free, no key) + Pillow fallback automatic
IMAGE_PROVIDER=card
IMAGE_API_KEY=
# Public media base (GitHub raw). GH Actions me repo se auto-set hota hai.
MEDIA_PUBLIC_BASE=

# Meta (Facebook Page + Instagram Professional)
META_GRAPH_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# X — BLOCKED (free tier khatam Feb 2026). Placeholders only.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=

# Reddit (script app OAuth)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=rayvice-agent/0.1 by rayviceteam-art

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
